{
  "name": "whm-api",
  "private": true,
  "version": "0.1.0",
  "description": "Cloudflare Worker + D1 API for Website Health Manager",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create whm-db",
    "db:migrate:local": "wrangler d1 execute whm-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute whm-db --remote --file=./schema.sql",
    "db:migrate:users:remote": "wrangler d1 execute whm-db --remote --file=./migrations/002_users.sql",
    "db:migrate:users:local": "wrangler d1 execute whm-db --local --file=./migrations/002_users.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4.118.0"
  }
}
